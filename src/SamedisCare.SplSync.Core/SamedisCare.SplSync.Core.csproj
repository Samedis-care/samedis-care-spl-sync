<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SamedisCare.SplSync.Core</RootNamespace>
    <AssemblyName>SamedisCare.SplSync.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Library: kein eigenständiges Publish-Ziel. Ohne dies versucht ein Solution-weiter
         `dotnet publish -p:PublishSingleFile=true` die DLL single-file zu veröffentlichen und
         bricht mit NETSDK1099 ab (Single-File nur für ausführbare Anwendungen). Als
         ProjectReference wird Core beim Tray-Publish trotzdem normal mitgeliefert. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <!-- DPAPI (ProtectedData / DataProtectionScope). Cross-platform package; on non-Windows
         the calls are no-ops gated by OperatingSystem.IsWindows() in ConfigStore. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- System.Data.OleDb: managed package, compiles cross-platform but only functional on Windows.
       OleDbActimedRepository carries [SupportedOSPlatform("windows")]; the class is always built
       (so Service/Tray on any host can publish for win-x64) and callers gate at runtime via
       OperatingSystem.IsWindows(). -->
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
  </ItemGroup>


  <!-- Auth, HTTP, gridfilter, tenant scope and logging come from the shared packages; the
       local Api/ folder held byte-identical copies of all of them. Newtonsoft and RestSharp
       arrive through them. -->
  <ItemGroup>
    <PackageReference Include="SamedisCare.Api" Version="1.1.0" />
    <PackageReference Include="SamedisCare.Helper" Version="1.1.0" />
  </ItemGroup>

</Project>
