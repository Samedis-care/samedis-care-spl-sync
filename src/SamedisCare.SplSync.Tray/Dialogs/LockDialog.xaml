<Window x:Class="SamedisCare.SplSync.Tray.Dialogs.LockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Actimed bitte schließen"
        Width="480" Height="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/assets/samedis-logo.png">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" FontSize="16" FontWeight="Bold">
            Actimed-Datenbank gesperrt
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0">
            Der Sync möchte Daten in die Actimed-Datenbank schreiben, kann das aber nicht,
            weil Actimed die Datenbank exklusiv geöffnet hat.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="Bold">
            Bitte schliesse Actimed kurz und klicke dann auf "Weiter".
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Später" Padding="12,4" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Weiter" Padding="12,4" IsDefault="True" Click="Continue_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
