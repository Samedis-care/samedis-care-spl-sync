<Window x:Class="SamedisCare.SplSync.Tray.Dialogs.TenantMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandanten zuordnen"
        Width="980" Height="720"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assets/samedis-logo.png">
    <DockPanel LastChildFill="True" Margin="14">

        <!-- Header / instructions -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Mandanten zuordnen" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Foreground="#444">
                Links: alle Samedis-Tenants, auf die der Sync-Account Zugriff hat.
                Rechts: alle Kunden aus Actimed (Tabelle A3_CUST). Pro Tenant einen oder mehrere
                Actimed-Kunden ankreuzen, plus "Aktiv" setzen, um den Sync zu aktivieren.
            </TextBlock>
        </StackPanel>

        <!-- Footer with action buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="DiagButton"   Content="Diagnose anzeigen" Padding="14,4" Margin="0,0,8,0" Click="ShowDiag_Click"/>
            <Button x:Name="ReloadButton" Content="Neu laden"          Padding="14,4" Margin="0,0,8,0" Click="Reload_Click"/>
            <Button x:Name="CancelButton" Content="Abbrechen"          Padding="14,4" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="SaveButton"   Content="Speichern"          Padding="14,4" IsDefault="True" Click="Save_Click"/>
        </StackPanel>

        <!-- Status panel: per-source results -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#CCC" BorderThickness="1" Padding="8" Margin="0,8,0,0" Background="#F8F8F8">
            <StackPanel>
                <TextBlock x:Name="SamedisStatusText" Margin="0,0,0,2"/>
                <TextBlock x:Name="ActimedStatusText" Margin="0,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Available customers reference (read-only) -->
        <Expander DockPanel.Dock="Bottom" Header="Actimed-Kunden anzeigen" Margin="0,8,0,0">
            <DataGrid x:Name="CustomersGrid"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      MaxHeight="180" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CUST_ID"   Binding="{Binding CustId}"   Width="80"/>
                    <DataGridTextColumn Header="Kürzel"   Binding="{Binding Short}"    Width="120"/>
                    <DataGridTextColumn Header="CUST_NO"   Binding="{Binding CustNo}"   Width="120"/>
                    <DataGridTextColumn Header="Name"      Binding="{Binding Name1}"    Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>

        <!-- Main mapping grid -->
        <DataGrid x:Name="MappingGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="36">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn  Header="Aktiv"             Binding="{Binding Enabled, Mode=TwoWay}" Width="60"/>
                <DataGridTextColumn      Header="Samedis-Tenant"    Binding="{Binding TenantDisplay}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn      Header="Tenant-ID"         Binding="{Binding SamedisTenantId}" Width="240" IsReadOnly="True"/>
                <DataGridTextColumn      Header="Anzeigename"       Binding="{Binding LocalName, Mode=TwoWay}" Width="*"/>
                <DataGridTextColumn      Header="Actimed-CUST_IDs"  Binding="{Binding CustIdsText, Mode=TwoWay}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
