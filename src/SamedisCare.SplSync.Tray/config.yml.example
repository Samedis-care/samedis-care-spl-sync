auth:
  uri: "https://ident.services"
  client_id: "sync-account@dienstleister.example"
  client_secret: "***"

samedis:
  uri: "https://sync.samedis.care"
  api_version: "v4"

  # Zugriffsweg: "tenant" (Standard) oder "enterprise".
  #   tenant     – der Sync-Account ist Mitglied des Mandanten, direkter Zugriff auf
  #                /api/v4/tenants/{mandant}/…  (Techniker im eigenen Haus).
  #   enterprise – Dienstleister mit Service-Welt; die Kunden sind seine Clients, alles
  #                läuft über /api/v4/enterprise/tenants/{dienstleister}/clients/{kunde}/…
  # Die Ressourcen und Felder sind in beiden Welten gleich, nur der Pfad-Präfix wechselt.
  access_mode: "tenant"
  # Nur bei access_mode "enterprise": der 24-stellige ObjectId des Dienstleister-Mandanten
  # (der Service-Welt selbst). Die Kundenmandanten stehen wie gewohnt unter tenants:.
  enterprise_tenant_id: ""

actimed:
  database_path: "C:\\Program Files (x86)\\Actimed3\\actimed3db.mdb"
  # Pickup-Verzeichnis für Modus 1 (PDF-Watcher).
  # Hier landen die vom Techniker aus Actimed gedruckten Prüfprotokolle (PDF).
  # Voraussetzung: Actimed Extras -> Optionen -> "Name des Druckauftrags" auf
  # "Inventarnummer_Prüfberichtsnummer" setzen, plus PDF-Drucker mit Auto-Save.
  protocol_pdf_dir: "C:\\Users\\Public\\Documents\\Actimed\\Reports"
  use_local_snapshot: true
  default_tester_name: "Servicetechniker"

branding:
  service_provider_name: "Mein Dienstleister GmbH"
  logo_path: "C:\\ProgramData\\SamedisCare\\SplSync\\logo.png"

tenants:
  - name: "Mandant 1"
    samedis_tenant_id: "<24-stelliger ObjectId aus Samedis>"
    actimed_cust_ids: [4, 7]
    enabled: true
  - name: "Mandant 2"
    samedis_tenant_id: "<...>"
    actimed_cust_ids: [5]
    enabled: true

sync:
  # Wie oft offene Aufträge + Inventar-Updates aus Samedis geholt werden.
  download_interval_minutes: 15
  # Wie oft die Actimed-DB nach neuen Prüfungen abgefragt wird (Modus 2).
  upload_poll_interval_seconds: 30
  run_on_network_reconnect: true

  download_inventories: true
  download_open_issues: true
  upload_finished_issues: true   # Master-Schalter

  # ---- Upload-Modi ----
  #
  # Modus 1 - Techniker arbeitet primaer in Actimed:
  #   - Prüfung wird in Actimed durchgeführt und gespeichert.
  #   - Techniker druckt Prüfprotokoll als PDF in protocol_pdf_dir.
  #   - Watcher erkennt PDF, korreliert Prüfberichtsnummer mit A3_FINISHED_TEST,
  #     schliesst Samedis-Vorgang inkl. PDF-Anhang ab.
  upload_mode_pdf_pickup: false

  # Modus 2 - Techniker arbeitet parallel in Samedis (Mobile/Web):
  #   - In Actimed wird nur die Messung mit dem Prüfgeraet durchgeführt.
  #   - Sobald die Messung in der DB landet, ziehen wir die Werte und erzeugen
  #     ein PNG-Wertenachweis-Bild, das wir an den Samedis-Vorgang anhängen.
  upload_mode_png_on_completion: true

  # Beide Modi gleichzeitig sind erlaubt - Vorgang erhaelt dann beide Anhänge.

  create_issues_from_actimed: false
  create_inventories_from_actimed: false
  set_inventory_operation_status_on_failed_maintenance: false

  # Erlaubt dem Sync, eine fehlende A3_ACTIVITY (Tätigkeit) selbst anzulegen, wenn für die
  # gemappte Tätigkeitsart (KIND) noch keine existiert. Voraussetzung: der passende
  # maintenance_kind_mapping-Eintrag gibt eine Prüfvorschrift an (actimed_test_spec_name
  # oder actimed_test_spec_id). Fehlt eine gültige Prüfvorschrift, wird NICHTS angelegt
  # (kein TEST_SPEC=1/"Unbekannt") — das Issue bleibt offen mit klarer Meldung.
  create_activities_from_mapping: false

  # Legt nach Abschluss einer Prüfung (Upload) automatisch die geplante Folgemaßnahme in Samedis
  # an: neues maintenance-Issue mit due_on = Prüfdatum + Intervall (Monate). Idempotent pro Test.
  create_planned_issue_after_completion: false

# Wartungsart-Mapping: regex auf Samedis-Wartungstyp/Titel/Services -> Actimed-Tätigkeit.
#
# Pflicht-Felder:
#   actimed_kind   — Name der A3_ACTIVITY_KIND (Tätigkeitsart) in Actimed.
#                    Muss exakt uebereinstimmen, inkl. Sonderzeichen wie '§'.
#
# Prüfvorschrift-Verknüpfung (eine der beiden Varianten pro Eintrag):
#   A) actimed_activity_name — Name einer BEREITS in Actimed vorhandenen A3_ACTIVITY
#      (Tätigkeit) mit hinterlegter Prüfvorschrift. Wird bevorzugt wiederverwendet.
#   B) actimed_test_spec_name / actimed_test_spec_id — Name bzw. ID der TEST_SPEC
#      (Prüfvorschrift). Nur wirksam, wenn create_activities_from_mapping=true UND für die
#      KIND noch keine Tätigkeit existiert: dann legt der Sync die Tätigkeit mit dieser
#      Prüfvorschrift an. TEST_SPEC=1 ("Unbekannt") wird abgelehnt.
#      actimed_activity_interval_months — Fallback-Prüfintervall der neuen Tätigkeit, falls die
#      Samedis-Maßnahme kein Intervall liefert (Samedis-Wert hat Vorrang; Default 12). Wirkt nur
#      beim erstmaligen Anlegen — existierende Tätigkeiten werden nicht überschrieben.
#
# Achtung: Es gibt in Actimed KEINE automatische Zuordnung "Wartungsart -> Prüfvorschrift".
# Die richtige TEST_SPEC hängt von der elektrischen Geräteklasse ab (SKI/SKII x B/BF/CF ...).
# Wenn die Geräte unter einer Wartungsart elektrisch unterschiedlich sind, ist Variante A
# (je Tätigkeit eine passende Vorschrift, in Actimed gepflegt) sauberer als Variante B.
maintenance_kind_mapping:
  - match: "(?i)dguv\\s*v?3|stk.*§\\s*11"
    actimed_kind: "MPBe_§11_STK/DGUV V3"
    # Variante A (existierende Tätigkeit wiederverwenden):
    # actimed_activity_name: "MPBe_§11_STK_DGUV_V3_Standard"
    # Variante B (Tätigkeit automatisch anlegen, benötigt create_activities_from_mapping: true):
    # actimed_test_spec_name: "EN50699_0702_SKI_ErsatzMessung_allg_Grenzwerte"
    # actimed_activity_interval_months: 24

  - match: "(?i)mtk.*bdm|blutdruck"
    actimed_kind: "MPBe_MTK_BDM"
    actimed_activity_name: "MPBe_Prüfung_MTK_BDM"

  - match: "(?i)defi.*aed"
    actimed_kind: "MPBe_STK Defi (AED)"
    actimed_activity_name: "MPBe_STK_Defi_AED_DP-300"

  - match: "(?i)wartung|inspektion"
    actimed_kind: "MPBe_§7_Wartung/Inspektion"
    # actimed_activity_name: "MPBe_§7_Wartung_Standard"        # auf eure Vorschrift anpassen

  # Fallback (entry without 'match'):
  - actimed_kind: "MPBe_§7_Wartung/Inspektion"

logging:
  level: 1     # 0 off, 1 info, 2 debug
  mode: 3      # 0 none, 1 console, 2 file, 3 console+file
  # Relativer Pfad wird relativ zum EXE-Ordner aufgelöst (wie state\ und scratch\).
  directory: "logs"

http:
  valid_certificate: true
  proxy: ""
  proxy_username: ""
  proxy_password: ""
