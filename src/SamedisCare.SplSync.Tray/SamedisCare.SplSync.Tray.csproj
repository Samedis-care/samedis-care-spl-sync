<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SamedisCare.SplSync.Tray</RootNamespace>
    <AssemblyName>SamedisCare.SplSync.Tray</AssemblyName>
    <ApplicationIcon>assets\samedis-logo.ico</ApplicationIcon>
    <!-- Erlaubt Restore/Build auf macOS/Linux. Lauffähige EXE entsteht aber nur via
         `dotnet publish -r win-x64` und/oder auf einer Windows-Maschine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logo icons embedded as WPF resources. The default (.ico/.png) is used by every
         window and as the idle/ok tray icon. *-error and *-warn are tinted variants
         (red / amber) used by UpdateTrayIcon to make problems visible at a glance. -->
    <Resource Include="assets\samedis-logo.ico" />
    <Resource Include="assets\samedis-logo.png" />
    <Resource Include="assets\samedis-logo-error.ico" />
    <Resource Include="assets\samedis-logo-error.png" />
    <Resource Include="assets\samedis-logo-warn.ico" />
    <Resource Include="assets\samedis-logo-warn.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SamedisCare.SplSync.Core\SamedisCare.SplSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- config.yml.example wird in die EXE eingebettet, damit der erste Start ohne
         Begleitdateien funktioniert: ConfigBootstrap.EnsureConfigExists liest die
         Resource und schreibt sie als config.yml neben die EXE. PreserveNewest
         lassen wir trotzdem stehen, weil Operations gern eine Kopie zur Hand hat. -->
    <EmbeddedResource Include="config.yml.example">
      <LogicalName>SamedisCare.SplSync.Tray.config.yml.example</LogicalName>
    </EmbeddedResource>
    <None Update="config.yml.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
